<!-- Fase 3: Alertas Críticas -->
<div id="fase3" class="tab-content">
    <h2>Alertas Críticas - Requieren Atención</h2>
    <p><span class="status-important">IMPORTANTE</span> - Solo se muestran problemas que requieren acción administrativa inmediata.</p>

    {% if stats.total_alerts | int == 0 %}
    <div class="no-alerts">
        <h3>✓ Sistema Operacional</h3>
        <p>No se detectaron alertas críticas que requieran atención administrativa.</p>
        <p><strong>Todas las validaciones están en estado satisfactorio.</strong></p>
    </div>
    {% else %}

    <!-- ALERTAS CRÍTICAS DE CONECTIVIDAD -->
    {% if stats.failed_conns | int > 0 %}
    <div class="alert-section">
        <h3 style="color: var(--danger-color);">CRÍTICO: Bases de Datos Sin Conexión ({{ stats.failed_conns }})</h3>
        <p><strong>Acción requerida:</strong> Verificar servicios, listener y conectividad de red inmediatamente.</p>
        <table>
            <thead>
                <tr>
                    <th>Instancia</th>
                    <th>Host</th>
                    <th>IP:Puerto</th>
                    <th>Error</th>
                    <th>Acción Sugerida</th>
                </tr>
            </thead>
            <tbody>
                {% for conn in connectivity_results %}
                {% if not conn.connection_successful %}
                <tr class="critical-alert">
                    <td><strong>{{ conn.instancia }}</strong></td>
                    <td>{{ conn.host }}</td>
                    <td>{{ conn.direccion_ip }}:{{ conn.puerto }}</td>
                    <td class="truncated-text" title="{{ conn.connection_error }}">
                        {{ conn.connection_error[:50] }}{% if conn.connection_error | length > 50 %}...{% endif %}
                    </td>
                    <td>Verificar listener y servicios Oracle</td>
                </tr>
                {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- ALERTAS CRÍTICAS DE JOBS -->
    {% if stats.broken_jobs_count | int > 0 %}
    <div class="alert-section">
        <h3 style="color: var(--danger-color);">CRÍTICO: Jobs en Estado BROKEN ({{ stats.broken_jobs_count }})</h3>
        <p><strong>Acción requerida:</strong> Reparar o deshabilitar jobs broken inmediatamente.</p>
        <table>
            <thead>
                <tr>
                    <th>Instancia</th>
                    <th>Job ID</th>
                    <th>Schema</th>
                    <th>Failures</th>
                    <th>Last Date</th>
                    <th>Acción Sugerida</th>
                </tr>
            </thead>
            <tbody>
                {% for job in job_results %}
                    {% for broken in job.broken_jobs %}
                    <tr class="critical-alert">
                        <td><strong>{{ broken[1] | default('N/A') }}</strong></td>
                        <td>{{ broken[2] | default('N/A') }}</td>
                        <td>{{ broken[3] | default('N/A') }}</td>
                        <td>{{ broken[4] | default('0') }}</td>
                        <td>{{ broken[6] | default('N/A') }}</td>
                        <td>Revisar job y corregir o deshabilitar</td>
                    </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- ALERTAS DE BACKUPS FALLIDOS -->
    {% if stats.backup_errors_count | int > 0 %}
    <div class="alert-section">
        <h3 style="color: var(--danger-color);">CRÍTICO: Backups Fallidos ({{ stats.backup_errors_count }})</h3>
        <p><strong>Acción requerida:</strong> Investigar y corregir fallos de backup inmediatamente.</p>
        <table>
            <thead>
                <tr>
                    <th>Instancia</th>
                    <th>Inicio</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Acción Sugerida</th>
                </tr>
            </thead>
            <tbody>
                {% for backup in backup_results %}
                    {% for error in backup.backup_errors %}
                    <tr class="critical-alert">
                        <td><strong>{{ backup.instancia }}</strong></td>
                        <td>{{ error[2] | default('N/A') }}</td>
                        <td>{{ error[4] | default('N/A') }}</td>
                        <td><span class="status-danger">{{ error[5] | default('FAILED') }}</span></td>
                        <td>Revisar logs RMAN y espacio en disco</td>
                    </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- ALERTAS DE ADVERTENCIA: ARCHIVELOG -->
    {% if stats.instances_no_archivelog_count | int > 0 %}
    <div class="warning-section">
        <h3 style="color: var(--warning-color);">ADVERTENCIA: Sin ARCHIVELOG en 12h ({{ stats.instances_no_archivelog_count }})</h3>
        <p><strong>Acción requerida:</strong> Verificar estrategia de backup y política de ARCHIVELOG.</p>
        <table>
            <thead>
                <tr>
                    <th>Instancia</th>
                    <th>Total Backups</th>
                    <th>ARCHIVELOG</th>
                    <th>Recomendación</th>
                </tr>
            </thead>
            <tbody>
                {% for backup in backup_results %}
                {% if backup.no_archivelog_in_12h %}
                <tr class="warning-alert">
                    <td><strong>{{ backup.instancia }}</strong></td>
                    <td>{{ backup.total_backups }}</td>
                    <td>{{ backup.archivelog_count }}</td>
                    <td>Configurar backup automático de ARCHIVELOG</td>
                </tr>
                {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- ALERTAS CRÍTICAS DE DISKGROUPS -->
    {% if stats.diskgroup_critical_count | int > 0 %}
    <div class="alert-section">
        <h3 style="color: var(--danger-color);">CRÍTICO: Diskgroups con Alta Ocupación ({{ stats.diskgroup_critical_count }})</h3>
        <p><strong>Acción requerida:</strong> Ampliar espacio o mover datos inmediatamente para evitar fallas del sistema.</p>
        <table>
            <thead>
                <tr>
                    <th>Instancia</th>
                    <th>Diskgroup</th>
                    <th>% Ocupación</th>
                    <th>Espacio Libre</th>
                    <th>Estado</th>
                    <th>Severidad</th>
                    <th>Acción Sugerida</th>
                </tr>
            </thead>
            <tbody>
                {% for dg in diskgroup_results %}
                    {% for critical in dg.critical_diskgroups %}
                    <tr class="critical-alert">
                        <td><strong>{{ dg.instancia }}</strong></td>
                        <td>{{ critical[1] | default('N/A') }}</td>
                        <td><strong>{{ '{:.1f}'.format(critical[7] | float) }}%</strong></td>
                        <td>{{ '{:,}'.format(critical[5] | int) }} MB</td>
                        <td>{{ critical[2] | default('N/A') }}</td>
                        <td>
                            {% if critical[7] | float > 95 %}
                                <span class="status-danger">EXTREMO</span>
                            {% elif critical[7] | float > 90 %}
                                <span class="status-danger">ALTO</span>
                            {% else %}
                                <span class="status-warning">MEDIO</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if critical[7] | float > 95 %}
                                Expandir diskgroup INMEDIATAMENTE
                            {% else %}
                                Planificar expansión
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- ALERTAS CRÍTICAS DE DATAGUARD -->
    {% if stats.dataguard_critical_count | int > 0 %}
    <div class="alert-section">
        <h3 style="color: var(--danger-color);">CRÍTICO: DataGuard con Lag Alto ({{ stats.dataguard_critical_count }})</h3>
        <p><strong>Acción requerida:</strong> Revisar sincronización inmediatamente para evitar pérdida de datos.</p>
        <table>
            <thead>
                <tr>
                    <th>Instancia</th>
                    <th>Thread</th>
                    <th>Lag (Diferencia)</th>
                    <th>Recibido</th>
                    <th>Aplicada</th>
                    <th>Acción Sugerida</th>
                </tr>
            </thead>
            <tbody>
                {% for dg in dataguard_results %}
                    {% for critical in dg.critical_lag %}
                    <tr class="critical-alert">
                        <td><strong>{{ dg.instancia }}</strong></td>
                        <td>{{ critical[0] | default('N/A') }}</td>
                        <td><strong>{{ critical[5] | default('N/A') }}</strong></td>
                        <td>{{ critical[1] | default('N/A') }}</td>
                        <td>{{ critical[3] | default('N/A') }}</td>
                        <td>Verificar sincronización DataGuard</td>
                    </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- ALERTAS DE ADVERTENCIA: ESTADÍSTICAS STALE -->
    {% if stats.stats_critical_count | int > 0 %}
    <div class="warning-section">
        <h3 style="color: var(--warning-color);">ADVERTENCIA: Estadísticas Obsoletas ({{ stats.stats_critical_count }})</h3>
        <p><strong>Acción requerida:</strong> Actualizar estadísticas para mejorar rendimiento de queries.</p>
        <table>
            <thead>
                <tr>
                    <th>Instancia</th>
                    <th>Owner</th>
                    <th>Tabla</th>
                    <th>Comando Sugerido</th>
                </tr>
            </thead>
            <tbody>
                {% for stat in stats_results %}
                    {% for stale in (stat.stale_tables | default([])) %}
                    <tr class="warning-alert">
                        <td><strong>{{ stat.instancia }}</strong></td>
                        <td>{{ stale[0] | default('N/A') }}</td>
                        <td>{{ stale[1] | default('N/A') }}</td>
                        <td style="font-family: monospace; font-size: 11px;">{{ stale[2] | default('N/A') }}</td>
                    </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {% endif %}
</div>