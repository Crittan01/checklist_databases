<!-- Fase 2: Información Operacional -->
<div id="fase2" class="tab-content">
    <h2>Información Operacional Completa</h2>
    <p><span class="status-warning">IMPORTANTE</span> - Solo se evalúan instancias con conectividad exitosa.</p>

    <!-- ESTADO DE JOBS ORACLE CON DESPLEGABLE SIMPLE -->
    <h3 style="color: var(--primary-color); margin-top: 30px;">ESTADO: Jobs Oracle</h3>
    <div class="summary-stats">
        {% if job_results | length > 0 %}
            {% set global_broken = job_results | map(attribute='broken_jobs_count') | map('int') | sum %}
            {% set global_failures = job_results | map(attribute='jobs_with_failures_count') | map('int') | sum %}
            <p><strong>Resumen Global:</strong> 
            Solo se consultan Jobs BROKEN (filtro administrativo) | 
            Total broken: <strong>{{ global_broken }}</strong> | 
            Con failures > 0: {{ global_failures }}
            </p>
            
            {% if global_broken > 0 %}
            <button onclick="toggleJobsDetail()" class="toggle-detail-btn" id="jobs-toggle">
                ▼ Ver detalle de {{ global_broken }} jobs broken
            </button>
            {% endif %}
        {% else %}
            <p><strong>Sin validaciones de jobs:</strong> 
            No se ejecutaron validaciones debido a problemas de conectividad. 
            Todas las bases de datos están inaccesibles.</p>
        {% endif %}
    </div>

    {% if job_results | length > 0 %}
    <table class="operational-table">
        <thead>
            <tr>
                <th>Instancia</th>
                <th>Estado Validación</th>
                <th>Jobs BROKEN</th>
                <th>Estado General</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            {% for job in job_results %}
            <tr class="{{ 'critical-alert' if job.broken_jobs_count | int > 0 else '' }}">
                <td><strong>{{ job.instancia | default('N/A') }}</strong></td>
                <td>
                    {% if job.jobs_validation_successful | default(false) %}
                        <span class="status-success">EXITOSA</span>
                    {% else %}
                        <span class="status-danger">ERROR</span>
                    {% endif %}
                </td>
                <td>{{ job.broken_jobs_count | default(0) }}</td>
                <td>
                    {% if job.broken_jobs_count | default(0) | int > 0 %}
                        <span class="status-danger">CRÍTICO</span>
                    {% else %}
                        <span class="status-success">SIN BROKEN JOBS</span>
                    {% endif %}
                </td>
                <td>{{ (job.validation_timestamp | default('N/A')) | regex_replace('T', ' ') | regex_replace('Z', '') }}</td>
            </tr>
            {% if not (job.jobs_validation_successful | default(false)) %}
            <tr>
                <td colspan="5">
                    <div class="error-details">
                        <strong>Error:</strong> {{ job.jobs_validation_error | default('Error desconocido') }}
                    </div>
                </td>
            </tr>
            {% endif %}
            {% endfor %}
        </tbody>
    </table>

    <!-- TABLA DETALLADA COLAPSIBLE -->
    {% set global_broken = job_results | map(attribute='broken_jobs_count') | map('int') | sum %}
    {% if global_broken > 0 %}
    <div id="jobs-detail" class="collapsible-section">
        <div class="detail-header">
            DETALLE: Jobs en Estado BROKEN ({{ global_broken }} encontrados)
        </div>
        <table>
            <thead>
                <tr>
                    <th>Host</th>
                    <th>Instancia</th>
                    <th>Job ID</th>
                    <th>Schema</th>
                    <th>Failures</th>
                    <th>Last Date</th>
                    <th>What (Comando)</th>
                </tr>
            </thead>
            <tbody>
                {% for job in job_results %}
                    {% if job.broken_jobs_count | default(0) | int > 0 %}
                        {% for broken in (job.broken_jobs | default([])) %}
                        <tr class="critical-alert">
                            <td>{{ broken[0] | default('N/A') }}</td>
                            <td><strong>{{ broken[1] | default(job.instancia) | default('N/A') }}</strong></td>
                            <td>{{ broken[2] | default('N/A') }}</td>
                            <td>{{ broken[3] | default('N/A') }}</td>
                            <td>{{ broken[4] | default('0') }}</td>
                            <td>{{ broken[6] | default('N/A') }}</td>
                            <td class="truncated-text" title="{{ broken[7] | default('N/A') | string }}">
                                {{ broken[7] | default('N/A') | string }}
                            </td>
                        </tr>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {% else %}
    <div class="info-box">
        <p><strong>No hay datos de validación de jobs disponibles.</strong></p>
        <p>Esto ocurre cuando:</p>
        <ul>
            <li>No hay conexiones exitosas a las bases de datos</li>
            <li>Las bases de datos están inaccesibles</li>
            <li>Errores en la configuración de conectividad</li>
        </ul>
    </div>
    {% endif %}

    <!-- ESTADO DE BACKUPS ORACLE -->
    <h3 style="color: var(--primary-color); margin-top: 40px;">ESTADO: Backups (Últimas 12 horas)</h3>
    <div class="summary-stats">
        <p><strong>Criterio de Evaluación:</strong> Backups de últimas 12 horas con análisis de alertas</p>
        {% if backup_results | length > 0 %}
        {% set global_backups = backup_results | map(attribute='total_backups') | map('int') | sum %}
        {% set global_failed = backup_results | map(attribute='failed_backups') | map('int') | sum %}
        <p><strong>Resumen Global:</strong> Total backups: {{ global_backups }} | Fallidos: {{ global_failed }} | Sin ARCHIVELOG: {{ stats.instances_no_archivelog_count }}</p>
        {% endif %}
    </div>
    
    {% if backup_results | length > 0 %}
    <table class="operational-table">
        <thead>
            <tr>
                <th>Instancia</th>
                <th>Estado Validación</th>
                <th>Total Backups</th>
                <th>Exitosos</th>
                <th>Fallidos</th>
                <th>ARCHIVELOG</th>
                <th>Estado ARCHIVELOG</th>
            </tr>
        </thead>
        <tbody>
            {% for backup in backup_results %}
            <tr class="{{ 'critical-alert' if backup.failed_backups | int > 0 else ('warning-alert' if backup.no_archivelog_in_12h else '') }}">
                <td><strong>{{ backup.instancia }}</strong></td>
                <td>
                    {% if backup.backup_validation_successful %}
                        <span class="status-success">EXITOSA</span>
                    {% else %}
                        <span class="status-danger">ERROR</span>
                    {% endif %}
                </td>
                <td>{{ backup.total_backups }}</td>
                <td>{{ backup.successful_backups }}</td>
                <td>{{ backup.failed_backups }}</td>
                <td>{{ backup.archivelog_count }}</td>
                <td>
                    {% if backup.no_archivelog_in_12h %}
                        <span class="status-warning">SIN ARCHIVELOG 12H</span>
                    {% else %}
                        <span class="status-success">PRESENTE</span>
                    {% endif %}
                </td>
            </tr>
            {% if not backup.backup_validation_successful %}
            <tr>
                <td colspan="7">
                    <div class="error-details">
                        <strong>Error:</strong> {{ backup.backup_validation_error }}
                    </div>
                </td>
            </tr>
            {% endif %}
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="info-box">
        <p>No hay datos de validación de backups disponibles.</p>
    </div>
    {% endif %}

    <!-- ESTADO DE DISKGROUPS ASM -->
    <h3 style="color: var(--primary-color); margin-top: 40px;">ESTADO: Diskgroups ASM (Ocupación > 80%)</h3>
    <div class="summary-stats">
        <p><strong>Criterio de Evaluación:</strong> Solo se muestran diskgroups con ocupación > 80% Y espacio libre < 100GB</p>
        {% if diskgroup_results | length > 0 %}
        {% set global_critical = diskgroup_results | map(attribute='total_critical_diskgroups') | map('int') | sum %}
        <p><strong>Resumen Global:</strong> {{ global_critical }} diskgroups críticos encontrados</p>
        {% endif %}
    </div>

    {% if diskgroup_results | length > 0 %}
    <table class="operational-table">
        <thead>
            <tr>
                <th>Instancia</th>
                <th>Estado Validación</th>
                <th>Diskgroups Críticos</th>
                <th>Muy Críticos (>95%)</th>
                <th>Estado General</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            {% for dg in diskgroup_results %}
            <tr class="{{ 'critical-alert' if dg.total_critical_diskgroups | int > 0 else '' }}">
                <td><strong>{{ dg.instancia | default('N/A') }}</strong></td>
                <td>
                    {% if dg.diskgroup_validation_successful | default(false) %}
                        <span class="status-success">EXITOSA</span>
                    {% else %}
                        <span class="status-danger">ERROR</span>
                    {% endif %}
                </td>
                <td>{{ dg.total_critical_diskgroups | default(0) }}</td>
                <td>{{ dg.very_critical_diskgroups | default([]) | length }}</td>
                <td>
                    {% if dg.total_critical_diskgroups | default(0) | int > 0 %}
                        <span class="status-danger">CRÍTICO</span>
                    {% else %}
                        <span class="status-success">SIN ALERTAS</span>
                    {% endif %}
                </td>
                <td>{{ (dg.validation_timestamp | default('N/A')) | regex_replace('T', ' ') | regex_replace('Z', '') }}</td>
            </tr>
            {% if not (dg.diskgroup_validation_successful | default(false)) %}
            <tr>
                <td colspan="6">
                    <div class="error-details">
                        <strong>Error:</strong> {{ dg.diskgroup_validation_error | default('Error desconocido') }}
                    </div>
                </td>
            </tr>
            {% endif %}
            {% endfor %}
        </tbody>
    </table>

    <!-- DETALLE DE DISKGROUPS CRÍTICOS -->
    {% set global_critical = diskgroup_results | map(attribute='total_critical_diskgroups') | map('int') | sum %}
    {% if global_critical > 0 %}
    <div style="margin-top: 20px;">
        <h4>DETALLE: Diskgroups Críticos ({{ global_critical }} encontrados)</h4>
        <table>
            <thead>
                <tr>
                    <th>Host</th>
                    <th>Diskgroup</th>
                    <th>Estado</th>
                    <th>Tipo</th>
                    <th>Total (MB)</th>
                    <th>Libre (MB)</th>
                    <th>Ocupado (MB)</th>
                    <th>% Ocupación</th>
                </tr>
            </thead>
            <tbody>
                {% for dg in diskgroup_results %}
                    {% if dg.total_critical_diskgroups | default(0) | int > 0 %}
                        {% for critical in (dg.critical_diskgroups | default([])) %}
                        <tr class="{{ 'critical-alert' if critical[7] | float > 95 else 'warning-alert' }}">
                            <td>{{ critical[0] | default('N/A') }}</td>
                            <td><strong>{{ critical[1] | default('N/A') }}</strong></td>
                            <td>{{ critical[2] | default('N/A') }}</td>
                            <td>{{ critical[3] | default('N/A') }}</td>
                            <td>{{ '{:,}'.format(critical[4] | int) if critical[4] | string | length > 0 else 'N/A' }}</td>
                            <td>{{ '{:,}'.format(critical[5] | int) if critical[5] | string | length > 0 else 'N/A' }}</td>
                            <td>{{ '{:,}'.format(critical[6] | int) if critical[6] | string | length > 0 else 'N/A' }}</td>
                            <td>
                                <strong style="color: {{ 'var(--danger-color)' if critical[7] | float > 95 else 'var(--warning-color)' }};">
                                    {{ '{:.1f}'.format(critical[7] | float) }}%
                                </strong>
                            </td>
                        </tr>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {% else %}
    <div class="info-box">
        <p>No hay datos de validación de diskgroups disponibles.</p>
    </div>
    {% endif %}
</div>