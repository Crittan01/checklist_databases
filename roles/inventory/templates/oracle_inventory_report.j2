<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oracle Database Check Report</title>
    <style>
        {{ lookup('file', 'oracle_report_styles.css') }}
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>Oracle Database Check Report</h1>
            <div class="header-info">
                <div><strong>Ejecutado desde:</strong> {{ hostname }}</div>
                <div><strong>Fecha:</strong> {{ execution_date }}</div>
                <div><strong>Hora:</strong> {{ execution_time }}</div>
            </div>
        </div>
        
        <!-- Dashboard -->
        <div class="dashboard">
            <div class="summary-card">
                <h2 class="summary-title">Resumen de Conectividad</h2>
                <div class="metric">
                    <div class="metric-value">{{ stats.connectivity_percent }}%</div>
                    <div class="metric-label">Conectividad</div>
                </div>
                <table style="margin: 10px 0; box-shadow: none;">
                    <tr>
                        <td><strong>Total Bases:</strong></td>
                        <td>{{ stats.total_dbs }}</td>
                    </tr>
                    <tr style="background: rgba(39, 174, 96, 0.1);">
                        <td><strong>Conectadas:</strong></td>
                        <td>{{ stats.successful_conns }}</td>
                    </tr>
                    <tr style="background: rgba(231, 76, 60, 0.1);">
                        <td><strong>Fallidas:</strong></td>
                        <td>{{ stats.failed_conns }}</td>
                    </tr>
                </table>
            </div>
            
            <div class="summary-card">
                <h2 class="summary-title">Estado de Alertas por Dominio</h2>
                <div class="metric">
                    <div class="metric-value" style="color: {{ 'var(--success-color)' if stats.total_alerts | int == 0 and stats.successful_conns | int > 0 else 'var(--danger-color)' }};">
                        {{ stats.total_alerts }}
                    </div>
                    <div class="metric-label">Total Alertas</div>
                </div>
                <table style="margin: 10px 0; box-shadow: none;">
                    <thead>
                        <tr style="background: var(--light-color); font-weight: 600;">
                            <td><strong>DOMINIO</strong></td>
                            <td><strong>ALERTAS</strong></td>
                            <td><strong>ESTADO</strong></td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Conectividad</strong></td>
                            <td>{{ stats.failed_conns }} bases sin acceso</td>
                            <td>
                                {% if stats.failed_conns | int > 0 %}
                                    <span class="status-danger">CRÍTICO</span>
                                {% else %}
                                    <span class="status-success">OK</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Backups</strong></td>
                            {% if stats.successful_conns | int == 0 %}
                                <td>No evaluado</td>
                                <td><span class="status-warning">NO EVALUADO</span></td>
                            {% else %}
                                <td>{{ (stats.backup_errors_count | int) + (stats.instances_no_archivelog_count | int) }} alertas</td>
                                <td>
                                    {% if stats.backup_errors_count | int > 0 %}
                                        <span class="status-danger">CRÍTICO</span>
                                    {% elif stats.instances_no_archivelog_count | int > 0 %}
                                        <span class="status-warning">VERIFICAR</span>
                                    {% else %}
                                        <span class="status-success">OK</span>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                        <tr>
                            <td><strong>Jobs</strong></td>
                            {% if stats.successful_conns | int == 0 %}
                                <td>No evaluado</td>
                                <td><span class="status-warning">NO EVALUADO</span></td>
                            {% else %}
                                <td>{{ stats.broken_jobs_count }} jobs broken</td>
                                <td>
                                    {% if stats.broken_jobs_count | int > 0 %}
                                        <span class="status-danger">CRÍTICO</span>
                                    {% else %}
                                        <span class="status-success">OK</span>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-button active" onclick="openTab('fase1')">Fase 1: Conectividad</button>
            <button class="tab-button" onclick="openTab('fase2')">Fase 2: Información Operacional</button>
            <button class="tab-button" onclick="openTab('fase3')">Fase 3: Alertas Críticas</button>
        </div>
        
        <!-- Fase 1: Conectividad -->
        <div id="fase1" class="tab-content active">
            <h2>Conectividad Oracle</h2>
            <p>Estado de conexiones a todas las bases de datos del inventario.</p>
            
            <table>
                <thead>
                    <tr>
                        <th>Instancia</th>
                        <th>Host</th>
                        <th>IP:Puerto</th>
                        <th>TNS</th>
                        <th>Usuario</th>
                        <th>Estado</th>
<!--                     
                        <th>Información BD</th>
-->
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    {% for conn in connectivity_results %}
                    <tr class="{{ 'critical-alert' if not conn.connection_successful else '' }}">
                        <td><strong>{{ conn.instancia }}</strong></td>
                        <td>{{ conn.host }}</td>
                        <td>{{ conn.direccion_ip }}:{{ conn.puerto }}</td>
                        <td>{{ conn.cadena_tns }}</td>
                        <td>{{ conn.usuario }}</td>
                        <td>
                            {% if conn.connection_successful %}
                                <span class="status-success">CONECTADA</span>
                            {% else %}
                                <span class="status-danger">ERROR</span>
                            {% endif %}
                        </td>
<!--
                        <td>
                            {% if conn.connection_successful and conn.database_info %}
                                <strong>BD:</strong> {{ conn.database_info.database_name | default('N/A') }}<br>
                                <strong>Instancia:</strong> {{ conn.database_info.instance_name | default('N/A') }}<br>
                                <strong>Host BD:</strong> {{ conn.database_info.server_host | default('N/A') }}<br>
                                <strong>Versión:</strong> {{ conn.database_info.database_version | default('N/A') }}<br>
                                <strong>Estado:</strong> {{ conn.database_info.instance_status | default('N/A') }}<br>
                                <strong>Rol:</strong> {{ conn.database_info.database_role | default('N/A') }}<br>
                                <strong>Modo:</strong> {{ conn.database_info.open_mode | default('N/A') }}
                            {% else %}
                                <span style="color: var(--danger-color);">No disponible</span>
                            {% endif %}
                        </td>
-->
                        <td>{{ conn.test_timestamp | regex_replace('T', ' ') | regex_replace('Z', '') }}</td>
                    </tr>
                    {% if not conn.connection_successful and conn.connection_error %}
                    <tr class="critical-alert">
                        <td colspan="8">
                            <div class="error-details">
                                <strong>Error:</strong> {{ conn.connection_error }}
                            </div>
                        </td>
                    </tr>
                    {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <!-- Fase 2: Información Operacional -->
        <div id="fase2" class="tab-content">
            <h2>Información Operacional Completa</h2>
            <p><span class="status-warning">IMPORTANTE</span> - Solo se evalúan instancias con conectividad exitosa.</p>

            <!-- ESTADO DE JOBS ORACLE CON DESPLEGABLE SIMPLE -->
            <h3 style="color: var(--primary-color); margin-top: 30px;">ESTADO: Jobs Oracle</h3>
            <div class="summary-stats">
                <p><strong>Resumen Global:</strong> 
                {% set global_broken = job_results | map(attribute='broken_jobs_count') | map('int') | sum %}
                {% set global_failures = job_results | map(attribute='jobs_with_failures_count') | map('int') | sum %}
                Solo se consultan Jobs BROKEN (filtro administrativo) | 
                Total broken: <strong>{{ global_broken }}</strong> | 
                Con failures > 0: {{ global_failures }}
                </p>
                
                {% if global_broken > 0 %}
                <button onclick="toggleJobsDetail()" class="toggle-detail-btn" id="jobs-toggle">
                    ▼ Ver detalle de {{ global_broken }} jobs broken
                </button>
                {% endif %}
            </div>

            {% if job_results | length > 0 %}
            <table class="operational-table">
                <thead>
                    <tr>
                        <th>Instancia</th>
                        <th>Estado Validación</th>
                        <th>Jobs BROKEN</th>
                        <th>Estado General</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    {% for job in job_results %}
                    <tr class="{{ 'critical-alert' if job.broken_jobs_count | int > 0 else '' }}">
                        <td><strong>{{ job.instancia }}</strong></td>
                        <td>
                            {% if job.jobs_validation_successful %}
                                <span class="status-success">EXITOSA</span>
                            {% else %}
                                <span class="status-danger">ERROR</span>
                            {% endif %}
                        </td>
                        <td>{{ job.broken_jobs_count }}</td>
                        <td>
                            {% if job.broken_jobs_count | int > 0 %}
                                <span class="status-danger">CRÍTICO</span>
                            {% else %}
                                <span class="status-success">SIN BROKEN JOBS</span>
                            {% endif %}
                        </td>
                        <td>{{ job.validation_timestamp | regex_replace('T', ' ') | regex_replace('Z', '') }}</td>
                    </tr>
                    {% if not job.jobs_validation_successful %}
                    <tr>
                        <td colspan="5">
                            <div class="error-details">
                                <strong>Error:</strong> {{ job.jobs_validation_error }}
                            </div>
                        </td>
                    </tr>
                    {% endif %}
                    {% endfor %}
                </tbody>
            </table>

            <!-- TABLA DETALLADA COLAPSIBLE SIMPLE -->
            {% if global_broken > 0 %}
            <div id="jobs-detail" class="collapsible-section">
                <div class="detail-header">
                    DETALLE: Jobs en Estado BROKEN ({{ global_broken }} encontrados)
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Host</th>
                            <th>Instancia</th>
                            <th>Job ID</th>
                            <th>Schema</th>
                            <th>Failures</th>
                            <th>Last Date</th>
                            <th>What (Comando)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for job in job_results %}
                            {% if job.broken_jobs_count | int > 0 %}
                                {% for broken in job.broken_jobs %}
                                <tr class="critical-alert">
                                    <td>{{ broken[0] | default('N/A') }}</td>
                                    <td><strong>{{ broken[1] | default('N/A') }}</strong></td>
                                    <td>{{ broken[2] | default('N/A') }}</td>
                                    <td>{{ broken[3] | default('N/A') }}</td>
                                    <td>{{ broken[4] | default('0') }}</td>
                                    <td>{{ broken[6] | default('N/A') }}</td>
                                    <td class="truncated-text" title="{{ broken[7] | default('N/A') | string }}">
                                        {{ (broken[7] | default('N/A') | string)[:60] }}{% if (broken[7] | default('') | string | length) > 60 %}...{% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            {% else %}
            <div class="info-box">
                <p>No hay datos de validación de jobs disponibles.</p>
            </div>
            {% endif %}

            <!-- ESTADO DE BACKUPS ORACLE -->
            <h3 style="color: var(--primary-color); margin-top: 40px;">ESTADO: Backups (Últimas 12 horas)</h3>
            <div class="summary-stats">
                <p><strong>Criterio de Evaluación:</strong> Backups de últimas 12 horas con análisis de alertas</p>
                {% if backup_results | length > 0 %}
                {% set global_backups = backup_results | map(attribute='total_backups') | map('int') | sum %}
                {% set global_failed = backup_results | map(attribute='failed_backups') | map('int') | sum %}
                <p><strong>Resumen Global:</strong> Total backups: {{ global_backups }} | Fallidos: {{ global_failed }} | Sin ARCHIVELOG: {{ stats.instances_no_archivelog_count }}</p>
                {% endif %}
            </div>
            
            {% if backup_results | length > 0 %}
            <table class="operational-table">
                <thead>
                    <tr>
                        <th>Instancia</th>
                        <th>Estado Validación</th>
                        <th>Total Backups</th>
                        <th>Exitosos</th>
                        <th>Fallidos</th>
                        <th>ARCHIVELOG</th>
                        <th>Estado ARCHIVELOG</th>
                    </tr>
                </thead>
                <tbody>
                    {% for backup in backup_results %}
                    <tr class="{{ 'critical-alert' if backup.failed_backups | int > 0 else ('warning-alert' if backup.no_archivelog_in_12h else '') }}">
                        <td><strong>{{ backup.instancia }}</strong></td>
                        <td>
                            {% if backup.backup_validation_successful %}
                                <span class="status-success">EXITOSA</span>
                            {% else %}
                                <span class="status-danger">ERROR</span>
                            {% endif %}
                        </td>
                        <td>{{ backup.total_backups }}</td>
                        <td>{{ backup.successful_backups }}</td>
                        <td>{{ backup.failed_backups }}</td>
                        <td>{{ backup.archivelog_count }}</td>
                        <td>
                            {% if backup.no_archivelog_in_12h %}
                                <span class="status-warning">SIN ARCHIVELOG 12H</span>
                            {% else %}
                                <span class="status-success">PRESENTE</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% if not backup.backup_validation_successful %}
                    <tr>
                        <td colspan="7">
                            <div class="error-details">
                                <strong>Error:</strong> {{ backup.backup_validation_error }}
                            </div>
                        </td>
                    </tr>
                    {% endif %}
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div class="info-box">
                <p>No hay datos de validación de backups disponibles.</p>
            </div>
            {% endif %}
        </div>
        
        <!-- Fase 3: Alertas Críticas -->
        <div id="fase3" class="tab-content">
            <h2>Alertas Críticas - Requieren Atención</h2>
            <p><span class="status-warning">IMPORTANTE</span> - Solo se muestran problemas que requieren acción administrativa inmediata.</p>

            {% if stats.total_alerts | int == 0 %}
            <div class="no-alerts">
                <h3>✓ Sistema Operacional</h3>
                <p>No se detectaron alertas críticas que requieran atención administrativa.</p>
                <p><strong>Todas las validaciones están en estado satisfactorio.</strong></p>
            </div>
            {% else %}

            <!-- ALERTAS CRÍTICAS DE CONECTIVIDAD -->
            {% if stats.failed_conns | int > 0 %}
            <div class="alert-section">
                <h3 style="color: var(--danger-color);">CRÍTICO: Bases de Datos Sin Conexión ({{ stats.failed_conns }})</h3>
                <p><strong>Acción requerida:</strong> Verificar servicios, listener y conectividad de red inmediatamente.</p>
                <table>
                    <thead>
                        <tr>
                            <th>Instancia</th>
                            <th>Host</th>
                            <th>IP:Puerto</th>
                            <th>Error</th>
                            <th>Acción Sugerida</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for conn in connectivity_results %}
                        {% if not conn.connection_successful %}
                        <tr class="critical-alert">
                            <td><strong>{{ conn.instancia }}</strong></td>
                            <td>{{ conn.host }}</td>
                            <td>{{ conn.direccion_ip }}:{{ conn.puerto }}</td>
                            <td class="truncated-text" title="{{ conn.connection_error }}">
                                {{ conn.connection_error[:50] }}{% if conn.connection_error | length > 50 %}...{% endif %}
                            </td>
                            <td>Verificar listener y servicios Oracle</td>
                        </tr>
                        {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            <!-- ALERTAS CRÍTICAS DE JOBS -->
            {% if stats.broken_jobs_count | int > 0 %}
            <div class="alert-section">
                <h3 style="color: var(--danger-color);">CRÍTICO: Jobs en Estado BROKEN ({{ stats.broken_jobs_count }})</h3>
                <p><strong>Acción requerida:</strong> Reparar o deshabilitar jobs broken inmediatamente.</p>
                <table>
                    <thead>
                        <tr>
                            <th>Instancia</th>
                            <th>Job ID</th>
                            <th>Schema</th>
                            <th>Failures</th>
                            <th>Last Date</th>
                            <th>Acción Sugerida</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for job in job_results %}
                            {% for broken in job.broken_jobs %}
                            <tr class="critical-alert">
                                <td><strong>{{ broken[1] | default('N/A') }}</strong></td>
                                <td>{{ broken[2] | default('N/A') }}</td>
                                <td>{{ broken[3] | default('N/A') }}</td>
                                <td>{{ broken[4] | default('0') }}</td>
                                <td>{{ broken[6] | default('N/A') }}</td>
                                <td>Revisar job y corregir o deshabilitar</td>
                            </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            <!-- ALERTAS DE BACKUPS FALLIDOS -->
            {% if stats.backup_errors_count | int > 0 %}
            <div class="alert-section">
                <h3 style="color: var(--danger-color);">CRÍTICO: Backups Fallidos ({{ stats.backup_errors_count }})</h3>
                <p><strong>Acción requerida:</strong> Investigar y corregir fallos de backup inmediatamente.</p>
                <table>
                    <thead>
                        <tr>
                            <th>Instancia</th>
                            <th>Inicio</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Acción Sugerida</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for backup in backup_results %}
                            {% for error in backup.backup_errors %}
                            <tr class="critical-alert">
                                <td><strong>{{ backup.instancia }}</strong></td>
                                <td>{{ error[2] | default('N/A') }}</td>
                                <td>{{ error[4] | default('N/A') }}</td>
                                <td><span class="status-danger">{{ error[5] | default('FAILED') }}</span></td>
                                <td>Revisar logs RMAN y espacio en disco</td>
                            </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            <!-- ALERTAS DE ADVERTENCIA: ARCHIVELOG -->
            {% if stats.instances_no_archivelog_count | int > 0 %}
            <div class="warning-section">
                <h3 style="color: var(--warning-color);">ADVERTENCIA: Sin ARCHIVELOG en 12h ({{ stats.instances_no_archivelog_count }})</h3>
                <p><strong>Acción requerida:</strong> Verificar estrategia de backup y política de ARCHIVELOG.</p>
                <table>
                    <thead>
                        <tr>
                            <th>Instancia</th>
                            <th>Total Backups</th>
                            <th>ARCHIVELOG</th>
                            <th>Recomendación</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for backup in backup_results %}
                        {% if backup.no_archivelog_in_12h %}
                        <tr class="warning-alert">
                            <td><strong>{{ backup.instancia }}</strong></td>
                            <td>{{ backup.total_backups }}</td>
                            <td>{{ backup.archivelog_count }}</td>
                            <td>Configurar backup automático de ARCHIVELOG</td>
                        </tr>
                        {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
            {% endif %}
        </div>
    </div>
    
    <script>
        // Función simple para alternar tabs
        function openTab(tabName) {
            var contents = document.getElementsByClassName('tab-content');
            for (var i = 0; i < contents.length; i++) {
                contents[i].classList.remove('active');
            }
            
            var buttons = document.getElementsByClassName('tab-button');
            for (var i = 0; i < buttons.length; i++) {
                buttons[i].classList.remove('active');
            }
            
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }

        // Función simple para mostrar/ocultar detalle de jobs
        function toggleJobsDetail() {
            var detailSection = document.getElementById('jobs-detail');
            var toggleBtn = document.getElementById('jobs-toggle');
            
            if (detailSection.classList.contains('expanded')) {
                detailSection.classList.remove('expanded');
                toggleBtn.innerHTML = '▼ Ver detalle de jobs broken';
            } else {
                detailSection.classList.add('expanded');
                toggleBtn.innerHTML = '▲ Ocultar detalle de jobs broken';
            }
        }
    </script>
</body>
</html>